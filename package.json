{
  "name": "fiber-tunnel",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "description": "React tunnel that renders content in fiber-tree order",
  "license": "MIT",
  "author": "Mara Kim <mara@astralarium.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astralarium/fiber-tunnel.git"
  },
  "keywords": [
    "react",
    "tunnel",
    "portal",
    "fiber",
    "react-three-fiber",
    "pixi",
    "tunnel-rat"
  ],
  "bugs": {
    "url": "https://github.com/astralarium/fiber-tunnel/issues"
  },
  "homepage": "https://astralarium.github.io/fiber-tunnel",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/fiber-tunnel.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b && eslint . && vite build && pnpm pack --out pack/%s-%v.tgz",
    "build:pages": "typedoc && cp site/index.html dist-pages/",
    "preview": "vite preview --outDir dist-pages --base /fiber-tunnel/",
    "prepublishOnly": "pnpm build",
    "lint": "eslint .",
    "check-types": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fiber-tunnel.js",
      "default": "./dist/fiber-tunnel.js"
    }
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^9.39.2",
    "@microsoft/api-extractor": "^7.59.4",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.0.0",
    "its-fine": "^2.0.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typedoc": "^0.28.16",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.0"
  }
}
